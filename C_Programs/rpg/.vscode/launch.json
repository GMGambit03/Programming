{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RPG",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/rpg",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build",
            "miDebuggerPath": "/usr/bin/gdb",

            "windows": {
                "name": "Debug Win RPG",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/rpg.exe",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
                "preLaunchTask": ""
            }
        }
    ]
}

