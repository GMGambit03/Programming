def findTheDifference(s, t):
    sint = 0
    tint = 0

    for i in s:
        sint += ord(i)
    for i in t:
        tint += ord(i)

    print(chr(tint - sint))

def strStr(haystack, needle):
    i = 0
    j = 0

    if len(haystack) < len(needle):
        return -1

    while i <= len(haystack) - 1:

        if haystack[i + j] == needle[j]:
             j += 1 
        else:
             i += 1
             j = 0

        if j == len(needle):
            return i
        
        if i + j > len(haystack) - 1:
            return -1

        

    return -1

            
def divide(dividend, divisor):
    sum = dividend
    is_negative = (dividend < 0) ^ (divisor < 0)

    if abs(dividend) > MAX_VALUE and divisor == -1: 
            return MAX_VALUE;

    i = 0
    while abs(sum) >= abs(divisor):
        if not is_negative:
            sum -= divisor
        else:
            sum += divisor
        i += 1
    i = i - (i * 2) if is_negative else i
    return i
